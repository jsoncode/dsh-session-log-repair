{
  "name": "dsh-session-repair",
  "version": "0.1.1",
  "author": "jsoncode",
  "license": "MIT",
  "private": true,
  "description": "DSH session-log repair plugin: scan every stored session, detect seq collisions in the committed region, and repair them from a one-click Web UI, model tools, or the /dsh-session-repair command. Installing it also registers the bundled dsh-session-log-repair skill (offline doctrine and scripts).",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "repository": "github:jsoncode/dsh-session-repair",
  "homepage": "https://github.com/jsoncode/dsh-session-repair#readme",
  "bugs": {
    "url": "https://github.com/jsoncode/dsh-session-repair/issues"
  },
  "keywords": [
    "dsh-plugin",
    "dsh-session-repair",
    "dsh-session-log-repair",
    "dsh-skill",
    "deepseek-harness",
    "session-log",
    "repair",
    "jsoncode"
  ],
  "engines": {
    "node": ">=22.15"
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./skill/*": "./skill/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "skill",
    "assets/logo.svg",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md"
  ],
  "scripts": {
    "check": "node scripts/check.mjs",
    "test": "npm run check && npm run test:install && npm run test:client && npm run test:host",
    "test:host": "node scripts/host-smoke.mjs",
    "test:client": "node scripts/client-smoke.mjs",
    "test:install": "node scripts/install-smoke.mjs",
    "install:profile": "node scripts/install.mjs --profile web",
    "uninstall:profile": "node scripts/install.mjs --profile web --uninstall",
    "release": "npm test && npm version patch -m \"release: v%s\" && git push --follow-tags"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-cordis-client-runner"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/dsh-tools": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-app-boot": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-session": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-session-persistence-jsonl": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-skill": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.2-rc.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "koffi"
    ]
  }
}
